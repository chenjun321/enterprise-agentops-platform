APP_NAME=enterprise-agentops-platform
APP_ENV=local
DATABASE_URL=sqlite:///./data/app.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
AUTO_INIT_LOCAL_DB=true
VECTOR_STORE=milvus_lite
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_LITE_URI=./data/milvus_lite.db
EMBEDDING_DIM=128
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SESSION_TTL_SECONDS=86400
ENABLE_EXTERNAL_SEARCH=false
INTERNAL_API_KEY=
PUBLIC_CHANNEL_TOKEN=
PUBLIC_CHANNEL_HEADER_NAME=X-Channel-Token
API_KEY_HEADER_NAME=X-API-Key
ENABLE_API_DOCS=false
EXPOSE_INTERNAL_TRACES=false
AUTH_TOKENS_JSON={"support-token":{"employee_id":"support_001","role":"support"},"sales-token":{"employee_id":"sales_001","role":"sales"},"marketing-token":{"employee_id":"marketing_001","role":"marketing"},"admin-token":{"employee_id":"admin_001","role":"admin"}}
USAGE_GUARD_ENABLED=true
USAGE_MINUTE_REQUEST_LIMIT=12
USAGE_HOUR_REQUEST_LIMIT=120
USAGE_DAY_TOKEN_LIMIT=20000
USAGE_SINGLE_INPUT_TOKEN_LIMIT=2000
USAGE_DUPLICATE_WINDOW_SECONDS=60
USAGE_DUPLICATE_LIMIT=3
THREAD_LOCK_TTL_SECONDS=120
THREAD_HISTORY_LIMIT=12
REFLECTION_ENABLED=true
LOG_LEVEL=INFO
